#:import Clock kivy.clock.Clock

# garden.kv
# ประกาศตัวจัดการหน้าจอ
WindowManager:
    MenuScreen:
    LevelScreen:
    GameScreen:
    CollectionScreen:
    SettingsScreen:

<MinimalButton>:
    font_name: 'assets/fonts/font.ttf'
    font_size: self.height * 0.42 if self.height > 0 else '22sp'
    color: 1, 1, 1, 1
    
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0 
    
    canvas.before:
        Color:
            rgba: (self.btn_color[0], self.btn_color[1], self.btn_color[2], 0.6 if self.state == 'normal' else 0.9)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [18]

        Color:
            rgba: (self.btn_color[0]*0.5, self.btn_color[1]*0.5, self.btn_color[2]*0.5, 1)
        Line:
            width: 2
            rounded_rectangle: (self.x, self.y, self.width, self.height, 18)

<EarthButton@Button>:
    font_name: 'assets/fonts/font.ttf'
    font_size: self.height * 0.42 if self.height > 0 else '24sp'
    background_normal: '' 
    canvas.before:
        PushMatrix
        Scale:
            origin: self.center
            x: 1.05 if self.state == 'down' else 1
            y: 1.05 if self.state == 'down' else 1
    canvas.after:
        PopMatrix

<DeathPopupContent@BoxLayout>:
    orientation: 'vertical'
    padding: [30, 40, 30, 30]
    spacing: 25
    canvas.before:
        Color:
            rgba: 0.96, 0.94, 0.88, 1 # สีครีมมินิมอล
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [25]
        # เส้นขอบบางๆ เพื่อความสวยงาม
        Color:
            rgba: 1, 1, 1, 0.1
        Line:
            width: 1.2
            rounded_rectangle: (self.x, self.y, self.width, self.height, 25)

    Label:
        text: "จบการปลูก"
        font_name: 'assets/fonts/font.ttf'
        font_size: '48sp'  # ขนาดใหญ่สื่อความหมายทันที
        color: 0.8, 0.2, 0.2, 1  # สีแดงสด (Red)
        bold: True
        size_hint_y: None
        height: 80

    Label:
        text: "ดอกไม้ของคุณเหี่ยวเฉาลงแล้ว...\nเนื่องจากขาดการเอาใจใส่จนพลังชีวิตหมดลง"
        font_name: 'assets/fonts/font.ttf'
        font_size: '18sp'
        color: 0.1, 0.1, 0.1, 1  # สีดำเข้มตามความต้องการ
        halign: 'center'
        valign: 'middle'
        text_size: self.width, None

    BoxLayout:
        orientation: 'horizontal'
        spacing: 15
        size_hint_y: None
        height: 60

        MinimalButton:
            id: retry_btn
            text: "ปลูกใหม่"
            btn_color: 0.2, 0.4, 0.9, 1  # ปุ่มหลัก: สีน้ำเงินสด (Primary Action)
            on_press: app.play_click()

        MinimalButton:
            id: home_btn
            text: "ออกจากการปลูก"
            btn_color: 0.4, 0.5, 0.4, 1  # ปุ่มรอง: สีเทาอมเขียว (Secondary Action)
            on_press: app.play_click()

# ----------------- หน้า 1: เมนูหลัก -----------------
<MenuScreen>:
    name: "menu"
    FloatLayout:
        Image:
            source: "assets/images/mainbg.png"
            fit_mode: "fill"

        BoxLayout:
            orientation: 'vertical'
            padding: [40, 220, 40, 50]
            spacing: 20
            size_hint: 0.7, 1.0
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}

            Widget: 
                size_hint_y: 1.0

            MinimalButton:
                text: "เริ่มการปลูก"
                size_hint_y: None
                height: root.height * 0.08 if root.height > 0 else 50
                on_release: app.root.current = "levels"
                on_press: app.play_click()
            
            MinimalButton:
                text: "คอลเลคชันของฉัน"
                size_hint_y: None
                height: root.height * 0.08 if root.height > 0 else 50
                on_release: app.root.current = "collection"
                on_press: app.play_click()
                
            MinimalButton:
                text: "วิธีเล่น"
                size_hint_y: None
                height: root.height * 0.08 if root.height > 0 else 50
                on_release: app.show_how_to_play()
                on_press: app.play_click()

            MinimalButton:
                text: "ตั้งค่า"
                size_hint_y: None
                height: root.height * 0.08 if root.height > 0 else 50
                on_release: app.root.current = "settings"
                on_press: app.play_click()


# ----------------- หน้า 2: เลือกด่าน (เรือนกระจก) -----------------
<LevelScreen>:
    name: "levels"
    FloatLayout:
        # พื้นหลังเรือนกระจก / ระเบียงต้นไม้
        Image:
            source: "assets/images/selectbg.png" 
            fit_mode: "fill"

        # เลเยอร์สีจางๆ เพื่อให้อ่านตัวหนังสือและเห็นปุ่มชัดขึ้น
        Widget:
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.4  # พื้นหลังดำโปร่งแสง 40%
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20,]

        BoxLayout:
            orientation: "vertical"
            padding: [40, 60, 40, 40]
            spacing: 20
            size_hint_x: None
            width: min(self.parent.width * 0.9, 800)
            size_hint_y: 0.95
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}

            Label:
                text: "เรือนกระจก"
                font_name: 'assets/fonts/font.ttf'
                font_size: self.height * 0.6
                color: 0.95, 0.98, 0.95, 1  # สีขาวนวลเพื่อให้อ่านง่ายบนพื้นหลังเข้ม
                outline_width: 1.5
                outline_color: 0.1, 0.2, 0.1, 1
                size_hint_y: None
                height: root.height * 0.1

            Label:
                text: "เลือกกระถางและเมล็ดพันธุ์ที่คุณต้องการปลูกวันนี้"
                font_name: 'assets/fonts/font.ttf'
                font_size: self.height * 0.45
                color: 0.9, 0.95, 0.9, 1
                size_hint_y: None
                height: root.height * 0.06

            # ใช้ GridLayout เพื่อเรียงปุ่ม
            GridLayout:
                cols: 2
                spacing: 15
                
                EarthButton:
                    text: "กุหลาบ"
                    background_color: 0.6, 0.3, 0.3, 0.9 # Earth Tone Muted Red
                    on_press: app.play_click()
                    on_release: app.start_game("rose")
                    
                EarthButton:
                    text: "ทิวลิป"
                    background_color: 0.5, 0.4, 0.5, 0.9 # Earth Tone Muted Purple
                    on_release: app.start_game("tulip")
                    on_press: app.play_click()
                EarthButton:
                    text: "เดซี่"
                    background_color: 0.6, 0.6, 0.3, 0.9 # Earth Tone Olive Yellow
                    on_release: app.start_game("daisy")
                    on_press: app.play_click()
                EarthButton:
                    text: "ทานตะวัน"
                    background_color: 0.7, 0.5, 0.2, 0.9 # Earth Tone Ochre
                    on_release: app.start_game("sunflower")
                    on_press: app.play_click()
                EarthButton:
                    text: "ชบา"
                    background_color: 0.7, 0.3, 0.3, 0.9 # Earth Tone Rust
                    on_release: app.start_game("hibiscus")
                    on_press: app.play_click()
                EarthButton:
                    text: "ลิลลี่"
                    background_color: 0.6, 0.6, 0.3, 0.9 # Earth Tone Rust
                    on_release: app.start_game("lilly")
                    on_press: app.play_click()

            Widget:
                size_hint_y: None
                height: 20

            MinimalButton:
                text: "กลับไปหน้าเมนู"
                size_hint_y: None
                height: root.height * 0.1
                size_hint_x: 0.6
                pos_hint: {'center_x': 0.5}
                background_color: 0.5, 0.6, 0.5, 0.9 # สีเทาอมเขียว
                on_release: app.root.current = "menu"
                on_press: app.play_click()

# --- กำหนด Custom Widget สำหรับ Vertical ProgressBar ---
<VerticalProgressBar@Widget>:
    value: 0
    max: 100
    bar_color: 0.2, 0.7, 0.5, 1 # สีเริ่มต้น (เขียว)
    canvas.before:
        # พื้นหลังของหลอด
        Color:
            rgba: 0, 0, 0, 0.4
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10,]
        # ตัวหลอดสีที่ขยับขึ้นลงตาม value
        Color:
            rgba: self.bar_color
        RoundedRectangle:
            pos: self.pos
            size: self.width, self.height * min(1.0, (self.value / float(self.max))) if self.max else 0
            radius: [10,]

# --- กำหนด Custom Widget สำหรับ Status Bar ที่มีป้ายชื่อ ---
<StatusGauge>:
    orientation: 'vertical'
    spacing: 1
    
    Label:
        text: root.label_text
        font_name: 'assets/fonts/font.ttf'
        font_size: '16sp'
        size_hint_y: 0.35
        color: 0.95, 0.95, 0.95, 1
        
    VerticalProgressBar:
        value: root.val
        max: root.max_v
        bar_color: root.color

# --- กำหนด Custom Widget สำหรับเนื้อหาสรุป/แจ้งเตือนแบบพรีเมียม ---
<ModernPopupContent>:
    orientation: 'vertical'
    padding: [25, 30, 25, 25]
    spacing: 20
    canvas.before:
        Color:
            rgba: 0.96, 0.96, 0.94, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [20]
        Color:
            rgba: 0.2, 0.4, 0.2, 0.1
        Line:
            width: 1.5
            rounded_rectangle: (self.x, self.y, self.width, self.height, 20)

    Label:
        text: root.title_text
        font_name: 'assets/fonts/font.ttf'
        font_size: '30sp'
        color: 0.1, 0.3, 0.1, 1
        bold: True
        size_hint_y: None
        height: 60

    Label:
        text: root.desc_text
        font_name: 'assets/fonts/font.ttf'
        font_size: '18sp'
        color: 0.2, 0.2, 0.2, 1
        halign: 'center'
        valign: 'middle'
        text_size: self.width, None
        size_hint_y: 1

    BoxLayout:
        id: button_area
        orientation: 'vertical'
        spacing: 12
        size_hint_y: None
        height: self.minimum_height

# ----------------- หน้า 3: พื้นที่เล่นเกม -----------------
<GameScreen>:
    name: "game"
    FloatLayout:
        Image:
            source: "assets/images/gamebg.png"
            fit_mode: "fill"

        # 1. แถบหัวข้อด้านบนสุด (Title Label)
        BoxLayout:
            name: 'title_bar'
            size_hint: 0.3, 0.08
            pos_hint: {'center_x': 0.5, 'top': 0.98}
            orientation: 'vertical'
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.6
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15]
            Label:
                id: title_lbl
                text: f"กำลังปลูก {getattr(root, 'flower_name', '...')}"
                font_name: 'assets/fonts/font.ttf'
                font_size: self.height * 0.6 if self.height > 0 else '20sp'
                color: 1, 1, 1, 1

        # 2. พื้นที่ดอกไม้กลางจอ (ปรับตำแหน่งใหม่ให้ไม่ลอยเกินไป)
        RelativeLayout:
            size_hint: None, None
            size: 600, 600
            pos_hint: {'center_x': 0.5, 'center_y': 0.45}

            # เอฟเฟกต์ออร่า (พื้นหลัง)
            Image:
                id: aura_img
                source: "assets/images/aura_effect.png"
                size_hint: None, None
                size: 380, 380
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                opacity: min(max(0, root.satisfaction_score - 100) / 100.0, 1.0)
                canvas.before:
                    PushMatrix
                    Rotate:
                        angle: (Clock.get_time() * 20) % 360
                        origin: self.center
                canvas.after:
                    PopMatrix

            # ตัวดอกไม้ (ใช้ Scatter ให้มีน้ำหนัก)
            Scatter:
                id: flower_scatter
                size: 400, 400
                do_rotation: False
                do_translation: False
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                Image:
                    id: flower_img
                    source: root.flower_image_source
                    size: self.parent.size
                    fit_mode: "contain"

        # ป้ายบอกวันที่ (Day Counter) อยู่มุมขวาบน
        Label:
            id: day_lbl
            text: f"วันที่: {root.care_days + 1}"
            font_name: 'assets/fonts/font.ttf'
            font_size: self.height * 0.45
            size_hint: 0.15, 0.08
            pos_hint: {'right': 0.98, 'top': 0.98}
            color: 1, 1, 1, 1
            bold: True
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.6
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10]

        # 3. ปุ่มเมนู / ออก (ย้ายมาไว้เดี่ยวๆ ที่ปุ่มเดียว)
        MinimalButton:
            text: "ออก"
            size_hint: None, None
            size: 100, 50
            pos_hint: {'x': 0.02, 'top': 0.98}
            btn_color: 0.4, 0.4, 0.4, 1
            on_release: root.show_exit_popup()
            on_press: app.play_click()

        # 3. แถบ HUD ด้านซ้าย (รวบหลอดสถานะทั้งหมด)
        BoxLayout:
            orientation: 'vertical'
            size_hint: None, 0.45
            width: 150
            pos_hint: {'x': 0.02, 'center_y': 0.65}
            spacing: 12
            padding: 15
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.6
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15]

            # หลอดพลังงาน (Stamina)
            StatusGauge:
                id: stamina_box
                label_text: "พลังงาน"
                val: app.stamina
                color: 0.2, 0.6, 0.8, 1

            # หลอดเอาใจใส่ (Affection)
            StatusGauge:
                id: care_box
                label_text: "ความเอาใจใส่"
                val: root.satisfaction_score
                max_v: root.phase_limit # ใช้ระบบเฟสเดียวกับ Growth
                color: 0.8, 0.2, 0.6, 1

            # หลอดเติบโต (Growth)
            StatusGauge:
                id: growth_box
                label_text: "การเจริญเติบโต"
                val: root.growth_score
                max_v: root.phase_limit
                color: 0.2, 0.8, 0.2, 1

            # หลอดที่ 4: พลังชีวิต (Health)
            StatusGauge:
                id: health_box
                label_text: "สุขภาพของดอกไม้"
                val: root.health_score
                color: 1, 0, 0, 1 

        # 4. แผงปุ่ม Action (จัดไว้ล่างสุดของ KV เพื่อให้เลเยอร์อยู่ด้านหน้าสุด)
        BoxLayout:
            id: action_panel
            orientation: 'vertical'
            size_hint: 0.96, 0.3
            pos_hint: {'center_x': 0.5, 'y': 0.01}
            padding: [15, 10]
            spacing: 8
            canvas.before:
                Color:
                    rgba: 0.96, 0.94, 0.88, 1 # สีครีมทึบ ไม่มองทะลุพื้นหลัง
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [25]
            # ป้ายแสดงผลลัพธ์
            Label:
                id: result_lbl
                text: "รอดูผลการดูแล..."
                font_name: 'assets/fonts/font.ttf'
                font_size: self.height * 0.5 if self.height > 0 else '18sp'
                color: 0.2, 0.2, 0.2, 1 
                size_hint_y: 0.25

            # ส่วนปุ่มกดแบบแนวนอน
            BoxLayout:
                size_hint_y: 0.75
                orientation: 'horizontal'
                spacing: 10
                
                # ตารางปุ่มหลัก (ปรับเป็น 2 คอลัมน์ x 2 แถว เพื่อความสมดุล)
                GridLayout:
                    id: main_actions
                    cols: 2
                    spacing: 12
                    size_hint_x: 1 if root.current_phase < 4 else 0.001
                    opacity: 1 if root.current_phase < 4 else 0
                    disabled: root.current_phase >= 4
                    
                    MinimalButton:
                        text: "รดน้ำ"
                        btn_color: 0.2, 0.5, 0.8, 1
                        on_release: root.water_plant()
                    MinimalButton:
                        text: "ใส่ปุ๋ย"
                        btn_color: 0.8, 0.6, 0.2, 1
                        on_release: root.fertilize_plant()
                    MinimalButton:
                        text: "พรวนดิน"
                        btn_color: 0.6, 0.4, 0.2, 1
                        on_release: root.till_soil()
                    MinimalButton:
                        text: "พักผ่อน"
                        btn_color: 0.2, 0.7, 0.5, 1
                        on_release: root.next_day_action()

                # ปุ่มเก็บเกี่ยว (แยกออกมาเป็นอิสระ)
                MinimalButton:
                    id: collect_btn
                    text: "ย้ายกระถางดอกไม้!"
                    size_hint_x: 0.9 if root.current_phase >= 4 else 0.001
                    opacity: 1 if root.current_phase >= 4 else 0
                    disabled: root.current_phase < 4
                    btn_color: 0.8, 0.6, 0.2, 1
                    on_release: root.collect_flower()

        # 5. Tooltip (คงเดิมไว้)
        Label:
            id: tooltip_lbl
            text: ""
            font_name: 'assets/fonts/font.ttf'
            font_size: '18sp'
            size_hint: None, None
            size: self.texture_size[0] + 20, self.texture_size[1] + 10
            pos: 0, -100
            opacity: 0
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.8
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [5,]

# ----------------- หน้า 4: สะสมดอกไม้ -----------------
<CollectionScreen>:
    name: "collection"
    FloatLayout:
        canvas.before:
            Color:
                rgba: 0.1, 0.1, 0.1, 1
            Rectangle:
                pos: self.pos
                size: self.size
        
        # 1. ฉากหลังสวนดอกไม้ที่สวยงาม
        Image:
            source: "assets/images/collectionbg.png"  # ภาพสวนที่มีดอกไม้เต็ม
            fit_mode: "cover"
            size_hint: 1, 1
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}

        # 1.3 ป้ายบอกเงินรวมมุมซ้ายบน
        Label:
            id: total_money_lbl
            text: "รวมทั้งหมด: 0 G"
            font_name: 'assets/fonts/font.ttf'
            font_size: '22sp'
            size_hint: None, None
            size: 200, 50
            pos_hint: {'x': 0.02, 'top': 0.98}
            color: 1, 1, 1, 1
            bold: True
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.6
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15]

        # 2. พื้นที่สำหรับวางดอกไม้ที่ปลูกสำเร็จ (ใช้สำหรับลากวาง)
        # เราจะสร้าง Widget เปล่าไว้รับการลากวางตรงนี้
        FloatLayout:
            id: garden_area

        # 3. แถบเก็บดอกไม้ (Inventory) ด้านล่าง
        BoxLayout:
            size_hint: 1, 0.2
            pos_hint: {'x': 0, 'y': 0}
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.6
                Rectangle:
                    pos: self.pos
                    size: self.size
            
            ScrollView:
                do_scroll_y: False
                GridLayout:
                    id: inventory_grid
                    rows: 1
                    size_hint_x: None
                    width: self.minimum_width
                    padding: 10
                    spacing: 10

        MinimalButton:
            text: "กลับ"
            size_hint: None, None
            size: root.width * 0.15, root.height * 0.08
            pos_hint: {'right': 0.98, 'top': 0.98}
            btn_color: 0.4, 0.5, 0.4, 1  # สีเทาอมเขียวให้เข้ากับปุ่มออก
            on_release: app.root.current = "menu"
            on_press: app.play_click()

# ----------------- หน้า 5: ตั้งค่า (Settings) -----------------
<SettingsScreen>:
    name: "settings"
    FloatLayout:
        Image:
            source: "assets/images/settingbg.png"
            fit_mode: "fill"
            
        BoxLayout:
            orientation: 'vertical'
            padding: 40
            spacing: 20
            size_hint: 0.8, 0.6
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}

            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.7
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20]
                    
            Label:
                text: "ตั้งค่า"
                font_name: 'assets/fonts/font.ttf'
                font_size: '36sp'
                size_hint_y: None
                height: 60
                
            Label:
                text: f"ระดับเสียงพืื้นหลัง: {int(master_volume.value * 100)}%"
                font_name: 'assets/fonts/font.ttf'
                font_size: '22sp'
                size_hint_y: None
                height: 40
                
            Slider:
                id: master_volume
                min: 0.0
                max: 1.0
                value: app.music_volume
                size_hint_y: None
                height: 50
                on_value: root.on_volume_change(*args)
                
            Widget:
                size_hint_y: 1
                
            MinimalButton:
                text: "กลับไปหน้าเมนู"
                size_hint_y: None
                height: 70
                size_hint_x: 0.6
                pos_hint: {'center_x': 0.5}
                on_release: app.root.current = "menu"
                on_press: app.play_click()
