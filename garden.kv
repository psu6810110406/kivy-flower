# garden.kv
# ประกาศตัวจัดการหน้าจอ
WindowManager:
    MenuScreen:
    LevelScreen:
    GameScreen:
    CollectionScreen:

# ----------------- หน้า 1: เมนูหลัก -----------------
<MenuScreen>:
    name: "menu"
    FloatLayout:
        # 1. พื้นหลังบรรยากาศในอพาร์ตเมนต์
        Image:
            source: "assets/images/garden.png" 
            fit_mode: "cover"

        # 2. เลเยอร์สีจางๆ เพื่อให้ตัวหนังสืออ่านง่ายขึ้น
        canvas.before:
            Color:
                rgba: 1, 1, 1, 0.2  # สีขาวโปร่งแสง 20%
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: "vertical"
            padding: [50, 100, 50, 50]
            spacing: 15
            size_hint: 0.7, 0.9
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}

            Label:
                text: "🌿 Apartment Garden 🌿"
                font_name: 'assets/fonts/font.ttf'
                font_size: '42sp'
                color: 0.1, 0.3, 0.1, 1  # สีเขียวเข้ม

            # เว้นระยะห่างระหว่างชื่อเกมกับปุ่ม
            Widget:
                size_hint_y: None
                height: 40

            # ปุ่มสไตล์ Modern
            Button:
                text: "Start Planting"
                font_name: 'assets/fonts/font.ttf'
                background_normal: '' 
                background_color: 0.2, 0.5, 0.2, 0.9 # สีเขียวใบไม้
                on_release: app.root.current = "levels"

# ----------------- หน้า 2: เลือกด่าน (เรือนกระจก) -----------------
<LevelScreen>:
    name: "levels"
    FloatLayout:
        # พื้นหลังเรือนกระจก / ระเบียงต้นไม้
        Image:
            source: "assets/images/garden.png" 
            fit_mode: "cover"

        # เลเยอร์สีจางๆ เพื่อให้อ่านตัวหนังสือและเห็นปุ่มชัดขึ้น
        Widget:
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.4  # พื้นหลังดำโปร่งแสง 40%
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20,]

        BoxLayout:
            orientation: "vertical"
            padding: [40, 60, 40, 40]
            spacing: 20
            size_hint_x: None
            width: min(self.parent.width * 0.9, 800)
            size_hint_y: 0.95
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}

            Label:
                text: "เรือนกระจก (Greenhouse)"
                font_name: 'assets/fonts/font.ttf'
                font_size: '36sp'
                color: 0.1, 0.4, 0.1, 1  # สีเขียวเข้ม
                outline_width: 1
                size_hint_y: None
                height: 60

            Label:
                text: "เลือกกระถางและเมล็ดพันธุ์ที่คุณต้องการปลูกวันนี้"
                font_name: 'assets/fonts/font.ttf'
                font_size: '20sp'
                color: 0.2, 0.3, 0.2, 1
                size_hint_y: None
                height: 40

            # ใช้ GridLayout เพื่อเรียงปุ่ม
            GridLayout:
                cols: 2
                spacing: 15
                
                Button:
                    text: "กุหลาบ"
                    font_name: 'assets/fonts/font.ttf'
                    font_size: '24sp'
                    background_normal: '' 
                    background_color: 0.8, 0.3, 0.4, 0.9 # โทนสีแดงอมชมพู
                    on_release: app.start_game("rose")
                Button:
                    text: "ทิวลิป"
                    font_name: 'assets/fonts/font.ttf'
                    font_size: '24sp'
                    background_normal: '' 
                    background_color: 0.8, 0.5, 0.7, 0.9 # โทนสีชมพูม่วง
                    on_release: app.start_game("tulip")
                Button:
                    text: "เดซี่"
                    font_name: 'assets/fonts/font.ttf'
                    font_size: '24sp'
                    background_normal: '' 
                    background_color: 0.9, 0.7, 0.2, 0.9 # โทนสีเหลือง
                    on_release: app.start_game("daisy")
                Button:
                    text: "ทานตะวัน"
                    font_name: 'assets/fonts/font.ttf'
                    font_size: '24sp'
                    background_normal: '' 
                    background_color: 0.9, 0.6, 0.1, 0.9 # โทนสีส้มเหลือง
                    on_release: app.start_game("sunflower")
                Button:
                    text: "ชบา"
                    font_name: 'assets/fonts/font.ttf'
                    font_size: '24sp'
                    background_normal: '' 
                    background_color: 0.9, 0.2, 0.3, 0.9 # โทนสีแดงสด
                    on_release: app.start_game("hibiscus")

            Widget:
                size_hint_y: None
                height: 20

            Button:
                text: "กลับเมนูหลัก"
                font_name: 'assets/fonts/font.ttf'
                font_size: '24sp'
                size_hint_y: None
                height: 70
                size_hint_x: 0.6
                pos_hint: {'center_x': 0.5}
                background_normal: '' 
                background_color: 0.5, 0.6, 0.5, 0.9 # สีเทาอมเขียว
                on_release: app.root.current = "menu"

# ----------------- หน้า 3: เล่นเกม (แบบใหม่) -----------------
<GameScreen>:
    name: "game"
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        # Dashboard สไตล์กระจก (Glassmorphism)
        BoxLayout:
            size_hint_y: 0.15
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 0.1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20,]
            Label:
                text: f"เงิน: {app.money}"
                font_name: 'assets/fonts/font.ttf'
                font_size: '22sp'
            Label:
                text: f"พลังงาน: {app.stamina}"
                font_name: 'assets/fonts/font.ttf'
                font_size: '22sp'
            Label:
                text: f"อากาศ: {app.weather}" # Widget ใหม่: สภาพอากาศ
                font_name: 'assets/fonts/font.ttf'
                font_size: '22sp'
                color: 1, 0.8, 0, 1

        # พื้นที่สวนอพาร์ตเมนต์
        FloatLayout:
            Image:
                source: "assets/images/garden.png"
                fit_mode: "cover"
            
            Widget:
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.4  # สีดำโปร่งแสง
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20,]

            BoxLayout:
                orientation: 'vertical'
                padding: 15
                spacing: 15
                size_hint: 0.9, 0.95
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}

                Label:
                    id: title_lbl
                    text: "กำลังปลูก..."
                    font_name: 'assets/fonts/font.ttf'
                    font_size: '22sp'
                    size_hint_y: None
                    height: 40
                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.6
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10,]
                
                ProgressBar:
                    id: growth_bar
                    max: 100
                    value: root.growth_progress
                    size_hint_y: None
                    height: 20

                FloatLayout:
                    Scatter:
                        id: flower_scatter
                        size_hint: None, None
                        size: 300, 300
                        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                        do_rotation: False
                        
                        Image:
                            id: flower_img
                            source: root.flower_image_source
                            size: flower_scatter.size

                # ส่วนควบคุมปุ่มกด GridLayout
                GridLayout:
                    cols: 3
                    spacing: 10
                    size_hint_y: None
                    height: 120
                    
                    Button:
                        text: "รดน้ำ"
                        font_name: 'assets/fonts/font.ttf'
                        background_normal: ''
                        background_color: 0.2, 0.4, 0.8, 0.9
                        on_release: root.water_plant()
                    Button:
                        text: "ใส่ปุ๋ย"
                        font_name: 'assets/fonts/font.ttf'
                        background_normal: ''
                        background_color: 0.6, 0.4, 0.2, 0.9
                        on_release: root.fertilize_plant()
                    Button:
                        text: "พรวนดิน"
                        font_name: 'assets/fonts/font.ttf'
                        background_normal: ''
                        background_color: 0.5, 0.3, 0.1, 0.9
                        on_release: root.till_soil()
                    Button:
                        text: "พักผ่อน (ข้ามวัน)"
                        font_name: 'assets/fonts/font.ttf'
                        background_normal: ''
                        background_color: 0.2, 0.6, 0.4, 0.9
                        on_release: app.next_day()

                Label:
                    id: result_lbl
                    text: "รอดูผลการดูแล..."
                    font_name: 'assets/fonts/font.ttf'
                    font_size: '20sp'
                    size_hint_y: None
                    height: 40
                    text_size: self.width, None
                    halign: 'center'
                    valign: 'middle'
                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.6
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10,]

                Button:
                    text: "ยอมแพ้ / กลับหน้าเลือกด่าน"
                    font_name: 'assets/fonts/font.ttf'
                    size_hint_y: None
                    height: 40
                    background_normal: ''
                    background_color: 0.8, 0.3, 0.3, 0.9
                    on_release: root.give_up()

# ----------------- หน้า 4: สะสมดอกไม้ -----------------
<CollectionScreen>:
    name: "collection"
    BoxLayout:
        orientation: "vertical"
        padding: 20
        spacing: 10

        Label:
            text: "ดอกไม้ที่คุณปลูกสำเร็จ"
            font_name: 'assets/fonts/font.ttf'
            font_size: '30sp'
            size_hint_y: None
            height: 50

        Label:
            id: collection_lbl
            text: "ยังไม่มีดอกไม้เลย ไปปลูกกันเถอะ!"
            font_name: 'assets/fonts/font.ttf'
            font_size: '20sp'

        Button:
            text: "กลับเมนูหลัก"
            font_name: 'assets/fonts/font.ttf'
            size_hint_y: None
            height: 60
            on_release: app.root.current = "menu"
