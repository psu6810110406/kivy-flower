# ประกาศตัวจัดการหน้าจอ
WindowManager:
    MenuScreen:
    LevelScreen:
    GameScreen:
    CollectionScreen:

# ----------------- หน้า 1: เมนูหลัก -----------------
<MenuScreen>:
    name: "menu"
    BoxLayout:
        orientation: "vertical"
        padding: 50
        spacing: 20

        Label:
            text: "เกมปลูกดอกไม้"
            font_name: 'font.ttf'
            font_size: '40sp'
        
        Button:
            text: "เริ่มเกม (เลือกด่าน)"
            font_name: 'font.ttf'
            font_size: '24sp'
            size_hint_y: None
            height: 80
            on_release: app.root.current = "levels" # เปลี่ยนไปหน้าด่าน
            
        Button:
            text: "สมุดสะสมดอกไม้"
            font_name: 'font.ttf'
            font_size: '24sp'
            size_hint_y: None
            height: 80
            on_release: app.root.current = "collection" # เปลี่ยนไปหน้าสะสม

# ----------------- หน้า 2: เลือกด่าน -----------------
<LevelScreen>:
    name: "levels"
    BoxLayout:
        orientation: "vertical"
        padding: 20
        spacing: 10

        Label:
            text: "เลือกดอกไม้ที่ต้องการปลูก"
            font_name: 'font.ttf'
            font_size: '30sp'
            size_hint_y: None
            height: 50

        # ใช้ GridLayout เพื่อเรียงปุ่มให้สวยงาม
        GridLayout:
            cols: 2
            spacing: 10
            
            Button:
                text: "กุหลาบ"
                font_name: 'font.ttf'
                on_release: app.start_game("rose")
            Button:
                text: "ทิวลิป"
                font_name: 'font.ttf'
                on_release: app.start_game("tulip")
            Button:
                text: "เดซี่"
                font_name: 'font.ttf'
                on_release: app.start_game("daisy")
            Button:
                text: "ทานตะวัน"
                font_name: 'font.ttf'
                on_release: app.start_game("sunflower")
            Button:
                text: "ชบา"
                font_name: 'font.ttf'
                on_release: app.start_game("hibiscus")

        Button:
            text: "กลับเมนูหลัก"
            font_name: 'font.ttf'
            size_hint_y: None
            height: 60
            on_release: app.root.current = "menu"

# ----------------- หน้า 3: เล่นเกม (โครงสร้างเดิมของคุณ) -----------------
<GameScreen>:
    name: "game"
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        Label:
            id: title_lbl
            text: "กำลังปลูก..."
            font_name: 'font.ttf'
            font_size: '24sp'
            size_hint_y: None
            height: 50
            # --- ยางลบสำหรับหัวข้อด้านบน ---
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 1  # สีดำทับพื้นหลัง
                Rectangle:
                    pos: self.pos
                    size: self.size

        # --- โซนรูปภาพ (ใช้ RelativeLayout เพื่อให้วางเลเยอร์ซ้อนกันได้) ---
        RelativeLayout:
            # ไม่ต้องใส่ size_hint_y หรือ height แล้ว 
            # มันจะขยายพื้นที่(สีขาว) ให้ใหญ่ที่สุดเท่าที่มีที่ว่างในหน้าจออัตโนมัติ!

            # เลเยอร์ที่ 1 (ล่างสุด): รูปพื้นหลัง (เช่น รูปสวน รูปดิน รูปกระถาง)
            Image:
                source: 'bg_garden.png'  
                allow_stretch: True      # ยอมให้ภาพยืดเต็มพื้นที่
                keep_ratio: False        # ไม่ต้องรักษาสัดส่วน (ให้เต็มกรอบพอดี)

            # เลเยอร์ที่ 2 (บนสุด): รูปดอกไม้ (จะซ้อนอยู่บนพื้นหลัง)
            Image:
                id: flower_img
                source: '' # จะถูกตั้งค่าจาก Python
                
                # คุณสามารถปรับขนาดและตำแหน่งดอกไม้ให้พอดีกับกระถางในรูปพื้นหลังได้ตรงนี้ครับ
                size_hint: (0.7, 0.7)  # ปรับขนาดดอกไม้ (0.7 คือ 70% ของกรอบ)
                
                # --- ส่วนที่แก้ไข: ปรับ 'center_y' ให้ค่าลดลง เพื่อให้รูปดอกไม้เลื่อนลงมา ---
                pos_hint: {'center_x': 0.5, 'center_y': 0.4} # ให้อยู่กึ่งกลางแนวนอน และเลื่อนลงมาเล็กน้อย
                # --------------------------------------------------------------------------
        # -----------------------------------------------------------
        BoxLayout:
            spacing: 10
            size_hint_y: None
            height: 50
            Spinner:
                id: spin_water
                text: 'น้ำ (1-5)'
                font_name: 'font.ttf'
                values: ['1', '2', '3', '4', '5']
            Spinner:
                id: spin_sun
                text: 'แดด (1-8)'
                font_name: 'font.ttf'
                values: ['1', '2', '3', '4', '5', '6', '7', '8']
            Spinner:
                id: spin_fert
                text: 'ปุ๋ย (1-4)'
                font_name: 'font.ttf'
                values: ['1', '2', '3', '4']

        Button:
            text: "ตรวจผล"
            font_name: 'font.ttf'
            font_size: '20sp'
            size_hint_y: None
            height: 60
            background_color: 0.2, 0.7, 0.3, 1
            on_press: root.check_answer()

        Label:
            id: result_lbl
            text: "รอการตรวจสอบ..."
            font_name: 'font.ttf'
            font_size: '20sp'
            size_hint_y: None
            height: 80
            
            # --- จัดระเบียบตัวหนังสือไม่ให้เบียดกัน ---
            text_size: self.width, None
            halign: 'center'
            valign: 'middle'
            
            # --- ยางลบสำหรับข้อความเฉลยด้านล่าง ---
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 1  # สีดำทับพื้นหลัง
                Rectangle:
                    pos: self.pos
                    size: self.size

        Button:
            text: "ยอมแพ้ / กลับหน้าเลือกด่าน"
            font_name: 'font.ttf'
            size_hint_y: None
            height: 50
            background_color: 0.8, 0.2, 0.2, 1
            on_release: app.root.current = "levels"

# ----------------- หน้า 4: สะสมดอกไม้ -----------------
<CollectionScreen>:
    name: "collection"
    BoxLayout:
        orientation: "vertical"
        padding: 20
        spacing: 10

        Label:
            text: "ดอกไม้ที่คุณปลูกสำเร็จ"
            font_name: 'font.ttf'
            font_size: '30sp'
            size_hint_y: None
            height: 50

        Label:
            id: collection_lbl
            text: "ยังไม่มีดอกไม้เลย ไปปลูกกันเถอะ!"
            font_name: 'font.ttf'
            font_size: '20sp'
            

        Button:
            text: "กลับเมนูหลัก"
            font_name: 'font.ttf'
            size_hint_y: None
            height: 60
            on_release: app.root.current = "menu"

        